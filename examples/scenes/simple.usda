#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
)

def Xform "World"
{
    def Cube "Box"
    {
        double size = 2
    }

    def Sphere "Ball"
    {
        double radius = 1
        custom string userProperties:label = "bouncy ball"
        double3 xformOp:translate = (3, 0, 1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

